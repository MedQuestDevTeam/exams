## Ignore Visual Studio temporary files, build results, and
## user-specific files

# Build results
bin/
obj/
[Ll]og/
*.log

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio Code settings
.vscode/

# ASP.NET Core secrets
secrets.json
**/appsettings.Development.json

# NuGet packages
*.nupkg
*.snupkg
packages/
.nuget/

# Entity Framework
Migrations/

# Dotnet artifacts
*.dbmdl
*.pdb
*.dll
*.exe

# Database files
*.mdf
*.ldf

# Rider IDE
.idea/

# Other temporary files
*.vs/
*.DS_Store
Thumbs.db

# Publish output
publish/
wwwroot/lib/