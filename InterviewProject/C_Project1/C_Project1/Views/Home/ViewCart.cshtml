@model IEnumerable<C_Project1.Models.ProductCartModel>

@{
    ViewData["Title"] = "Cart Item";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Price ($)</th>
                <th>Cart Quantity</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                int index = 1;
                foreach (var cartItem in Model)
                {
                    <tr>
                        <td>@index</td>

                        <td>@cartItem.Product?.Name</td>
                        <td>@cartItem.Product?.Price.ToString("F2")</td>
                        <td>@cartItem.ProductQuantity</td>
                        <td>
                            <form asp-controller="ViewCart" asp-action="Delete" asp-route-id="@cartItem.Id" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this product?');">Delete</button>
                            </form>
                        </td>
                    </tr>
                    index++;
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center">No products available.</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="container mt-3">
        <form asp-controller="ViewCart" asp-action="CheckOut" method="post">
            <button type="submit" class="btn btn-success">Check Out</button>
        </form>
    </div>
</div>
