@{
    ViewData["Title"] = "Home Page";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <h2 class="mb-4">@ViewData["Title"]</h2>
    <body>
        <div id="app">
            <label for="date">Select Date:</label>
            <input type="month" v-model="selectedDate" id="date" />
            <p>Working day for this month before holiday : {{workingDaysWithoutHoliday}}</p>
            <p>Working day for this month after holiday: {{workingDaysWithHoliday}}</p>

            <button v-on:click="checkUrl">Click Me</button>
        </div>
    </body>

</div>

<script>
    const { createApp } = Vue;

    createApp({
      data() {
        return {
          workingDaysWithoutHoliday:'',
          workingDaysWithHoliday:'',
          selectedDate: '',
        };
      },
      methods: {
        async checkUrl() {
          try {
            var year = this.selectedDate.split('-')[0];
            var month = this.selectedDate.split('-')[1];
            var days = new Date(year, month, 0).getDate();
            var weekdayCount = 0;

            var dataset = '';
            if(year === "2025"){
                dataset = "d_3751791452397f1b1c80c451447e40b7";
            }else if(year === "2026"){
                dataset = "d_149b61ad0a22f61c09dc80f2df5bbec8";
            }

            const response = await fetch("https://data.gov.sg/api/action/datastore_search?resource_id=" + dataset, { method: 'Get' });
            var data = await  response.json();
            var holidayDate = data.result.records.map(a=>a.date);
            var holidayMonth = holidayDate.map(a => a.split('-')[1]);
            var countHolidayOfMonth = holidayMonth.filter(a=>a === month).length;

            for (let day = 1; day <= days; day++){
                var currentday = new Date(year, month - 1, day);
                var dayofWeek = currentday.getDay();

                if (dayofWeek !== 0 && dayofWeek !== 6) {
                    weekdayCount++;
                }
            }

            


            if (response.ok) {
              this.workingDaysWithHoliday = weekdayCount;

              weekdayCount -= countHolidayOfMonth;

              this.workingDaysWithoutHoliday = weekdayCount;
            }
          } catch (error) {
            this.workingDaysWithoutHoliday = error;
              this.workingDaysWithHoliday = error;
          }
        }
      }
    }).mount('#app');
</script>
