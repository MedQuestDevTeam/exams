@model IEnumerable<C_Project3.Models.BookBorrowModel>

@{
    ViewData["Title"] = "Borrow List";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Borrow Date</th>
                <th>Free borrow until</th>
                <th>Fee Charged</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                int index = 1;
                foreach (var bookBorrow in Model)
                {
                    <tr>
                        <td>@index</td>
                        <td>@bookBorrow.BookInfo?.Name</td>
                        <td>@bookBorrow.BookBorrowDate.ToString("MM/dd/yyyy")</td>
                        <td>@bookBorrow.BookBorrowDate.AddDays(7).ToString("MM/dd/yyyy")</td>
                        <td>@bookBorrow.PriceCharged</td>
                        <td>
                            <form asp-controller="BorrowList" asp-action="Return" asp-route-id="@bookBorrow.Id" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-warning" onclick="return confirm('Thanks for return book, Price charged : @bookBorrow.PriceCharged');">Return</button>
                            </form>
                        </td>
                    </tr>
                    index++;
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center">No products available.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
