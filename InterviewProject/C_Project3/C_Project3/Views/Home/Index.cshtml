@model IEnumerable<C_Project3.Models.BookInfoModel>

@{
    ViewData["Title"] = "Home Page";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <p>Book Fee : Free for 1st week, 2nd week onward will charged 1SGD per week</p>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                int index = 1;
                foreach (var book in Model)
                {
                    <tr>
                        <td>@index</td>
                        <td>@book.Name</td>
                        <td>
                            <form asp-action="BorrowBook" asp-controller="Home" asp-route-id="@book.Id" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-primary">Borrow Book</button>
                            </form>
                            <form asp-action="Delete" asp-route-id="@book.Id" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this product?');">Delete</button>
                            </form>

                        </td>
                    </tr>
                    index++;
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center">No products available.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
